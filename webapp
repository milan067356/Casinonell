<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>allDep — Краш</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <link rel="stylesheet" href="/static/style.css">
</head>
<body>
    <div class="app">
        <div class="header">
            <div class="logo">allDep</div>
            <div class="balance"><span id="balance">1000</span> ⭐</div>
        </div>

        <div class="game-area">
            <div class="multiplier" id="multiplier">1.00×</div>
            <div class="rocket-container">
                <div class="trail" id="trail"></div>
                <div class="rocket" id="rocket">🚀</div>
            </div>
            <div class="status" id="status">Очікування раунду...</div>
        </div>

        <div class="bet-panel">
            <div class="bet-controls">
                <button onclick="changeBet(-5)">−</button>
                <input type="number" id="betAmount" value="10" min="5">
                <button onclick="changeBet(5)">+</button>
            </div>
            <button class="btn-main" id="actionBtn" onclick="action()">Поставити</button>
        </div>

        <div class="players">
            <div class="players-title">Ставки гравців</div>
            <div id="playersList"></div>
        </div>
    </div>
    <script src="/static/crash.js"></script>
</body>
</html>
